graph{rankdir=LR; node [fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9]; node[shape=plaintext];
Tour[label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#fef9c3"><tr><td bgcolor="#facc15"><b>Tour</b></td></tr><tr><td align="left">PK tour_id</td></tr><tr><td align="left">title, destination</td></tr><tr><td align="left">kind, status</td></tr><tr><td align="left">date_from, date_to</td></tr><tr><td align="left">price</td></tr><tr><td align="left">FK manager_id</td></tr></table>>];
Manager[label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#dbeafe"><tr><td bgcolor="#60a5fa"><b>Manager</b></td></tr><tr><td align="left">PK manager_id</td></tr><tr><td align="left">full_name, phone</td></tr><tr><td align="left">login, pwd_hash, role</td></tr></table>>];
Partner[label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#dcfce7"><tr><td bgcolor="#4ade80"><b>Partner</b></td></tr><tr><td align="left">PK partner_id</td></tr><tr><td align="left">name, kind</td></tr><tr><td align="left">city, contact</td></tr></table>>];
Quota[label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#dcfce7"><tr><td bgcolor="#4ade80"><b>Quota</b></td></tr><tr><td align="left">PK quota_id</td></tr><tr><td align="left">FK tour_id, FK partner_id</td></tr><tr><td align="left">seats_total, seats_left</td></tr></table>>];
Client[label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#fce7f3"><tr><td bgcolor="#f472b6"><b>Client</b></td></tr><tr><td align="left">PK client_id</td></tr><tr><td align="left">full_name, passport</td></tr><tr><td align="left">phone</td></tr></table>>];
Voucher[label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#fce7f3"><tr><td bgcolor="#f472b6"><b>Voucher</b></td></tr><tr><td align="left">PK voucher_id</td></tr><tr><td align="left">FK tour_id, FK client_id</td></tr><tr><td align="left">seats, amount, paid</td></tr><tr><td align="left">status, created</td></tr></table>>];
Review[label=<<table border="0" cellborder="1" cellspacing="0" bgcolor="#ede9fe"><tr><td bgcolor="#a78bfa"><b>Review</b></td></tr><tr><td align="left">PK review_id</td></tr><tr><td align="left">FK voucher_id</td></tr><tr><td align="left">rating 1..5, text</td></tr></table>>];
Manager--Tour[label="1 : N\nотвечает"]; Tour--Quota[label="1 : N"]; Partner--Quota[label="1 : N"]; Tour--Voucher[label="1 : N"]; Client--Voucher[label="1 : N"]; Voucher--Review[label="1 : 0..1"];
}
